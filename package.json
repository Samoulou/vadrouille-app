{
  "name": "vadrouille-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "VADROUILLE_ENV=local next dev",
    "build": "next build",
    "start": "node scripts/serve-standalone.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.p0.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "db:generate": "node --conditions=react-server node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/migrate.ts",
    "reprise-studio": "node --conditions=react-server --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reprise-studio.ts",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e": "playwright test --project=e2e",
    "test:prototype-cache": "playwright test --project=prototype-cache --no-deps --workers=1",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:perf": "playwright test --project=perf --workers=1",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:db && pnpm build && E2E_SKIP_BUILD=1 pnpm test:a11y && E2E_SKIP_BUILD=1 pnpm test:e2e && E2E_SKIP_BUILD=1 pnpm test:prototype-cache && E2E_SKIP_BUILD=1 pnpm test:visual",
    "p0": "node --import ./scripts/p0/enregistrer.mjs scripts/p0/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "@workflow/core>devalue": "5.9.4",
      "@workflow/core>nanoid": "5.1.16"
    }
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "ai": "7.0.122",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "nodemailer": "10.0.16",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "pg-connection-string": "2.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "undici": "8.11.2",
    "workflow": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/google.maps": "3.66.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
