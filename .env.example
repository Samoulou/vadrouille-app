# Carte Google Maps (F4, Q3). Valeurs posées dans Vercel par Samuel ; ne jamais committer de valeur réelle.
# Sans valeur, la carte affiche son état de remplacement « Carte indisponible ».
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Base de données (spécification B1, noms de la décision 0036, B1-TL-3). Jamais DATABASE_URL : l'intégration Neon de Vercel
# la pose avec l'identifiant propriétaire, que l'application refuse (db/connection.ts). Aucune connexion en
# production avant la passe de sécurité de la mise en public (décision 0034).
VADROUILLE_DATABASE_URL=
VADROUILLE_DATABASE_URL_AUTH=
# Environnement des migrations seulement (CI ; jamais dans Vercel) : pnpm db:migrate.
VADROUILLE_DATABASE_URL_MIGRATOR=
